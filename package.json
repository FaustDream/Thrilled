{
  "name": "thrilled",
  "version": "4.1.0",
  "description": "Thrilled — Chrome MV3 新标签页（v4：React 18 + Vite + TypeScript）",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "build:prod": "node scripts/build.mjs --prod",
    "release": "node scripts/release.mjs",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ tests/",
    "prepack": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.24.0",
    "eslint": "^9.17.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.18.0",
    "vite": "^8.3.1",
    "vitest": "^3.0.0",
    "zod": "^3.24.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
